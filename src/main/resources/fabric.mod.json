{
	"schemaVersion": 1,
	"id": "couchcraft_omega",
	"provides": [
		"couchcraft"
	],
	"version": "${version}",
	"name": "Couchcraft Omega",
	"description": "An enhanced fork of Couchcraft 0.2.0: true single-client split screen for up to four players, with Distant Horizons support, Shift/Ctrl on the shoulder buttons and a controller button map.",
	"authors": [
		"Vasissualiyp",
		"Zortos (original Couchcraft)"
	],
	"license": "MIT",
	"icon": "assets/couchcraft/icon.png",
	"contact": {
		"sources": "https://github.com/Vasissualiyp/CouchcraftOmega",
		"issues": "https://github.com/Vasissualiyp/CouchcraftOmega/issues",
		"homepage": "https://github.com/Vasissualiyp/CouchcraftOmega"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.couchcraft.Couchcraft"
		]
	},
	"mixins": [
		"couchcraft.mixins.json",
		"couchcraft.dh.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"breaks": {
		"iris": "*"
	},
	"suggests": {
		"distanthorizons": "*"
	}
}
